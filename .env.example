# ============================================================
# CONTROLLED ORDER AGENT
# Example environment configuration
#
# Copy this file to .env only for local configuration:
#
#   Copy-Item .env.example .env
#
# Never commit real credentials or secrets.
# ============================================================


# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================

# Supported usage:
#   development
#   production
#
# Production mode applies stricter security behavior.
CONTROLLED_AGENT_ENV=development


# Debug is automatically prevented in production.
CONTROLLED_AGENT_DEBUG=false


# Application logging level.
#
# Supported:
#   DEBUG
#   INFO
#   WARNING
#   ERROR
#   CRITICAL
CONTROLLED_AGENT_LOG_LEVEL=INFO


# ============================================================
# PERSISTENCE
# ============================================================

# SQLite database used for:
#   - agent runs
#   - approval records
#   - tickets
#   - audit events
#
# Parent directories are created automatically.
CONTROLLED_AGENT_DB=data/controlled_agent.db


# ============================================================
# API CLIENT
# ============================================================

# Base URL used by the desktop/API client.
CONTROLLED_AGENT_API_URL=http://127.0.0.1:8000


# ============================================================
# AUTHENTICATION / AUTHORIZATION
# ============================================================

# General administrative / backward-compatible credential.
#
# Use a strong random secret outside local development.
CONTROLLED_AGENT_API_KEY=


# Role-specific credentials for least-privilege access.
CONTROLLED_AGENT_READER_API_KEY=
CONTROLLED_AGENT_OPERATOR_API_KEY=
CONTROLLED_AGENT_APPROVER_API_KEY=


# ============================================================
# SECURITY SIMULATION
# ============================================================

# Enables controlled security-test behavior.
#
# Keep disabled during normal use.
# Security simulation cannot be enabled in production.
CONTROLLED_AGENT_ALLOW_SECURITY_SIMULATION=false


# ============================================================
# OPTIONAL OPENAI LLM PLANNER
# ============================================================

# The project includes an optional OpenAI-backed LLMPlanner.
#
# It is NOT required for the default deterministic runtime,
# automated test suite, or production-style evaluation.
#
# Install the optional dependency with:
#
#   python -m pip install -e ".[llm]"
#
# Configure these only when explicitly using LLMPlanner.
#
# Never commit a real API key.
OPENAI_API_KEY=

# Set this to a model available to your OpenAI account when
# using the optional LLMPlanner.
OPENAI_MODEL=